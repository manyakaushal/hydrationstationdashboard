generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  station HydrationStation[]
}

model HydrationStation {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  bottlesWashed       Int
  lastCleaningCycleAt DateTime?
  soapWeight          Float               @default(0)
  powerUsageHistory   PowerUsageHistory[]
  waterUsageHistory   WaterUsageHistory[]
  sensorReadings      SensorReadings[]
}

model PowerUsageHistory {
  id        Int              @id @default(autoincrement())
  stationId Int
  station   HydrationStation @relation(fields: [stationId], references: [id])
  createdAt DateTime         @default(now())
  day       DateTime? // To record once a day

  measuredAt DateTime // Obtained from the timestamp of the request sent to the server (x-axis)
  powerKw    Float // Calculated from sensor readings (y-axis)

  @@unique([stationId, day]) // To record once a day
  @@index([measuredAt, powerKw])
}

model WaterUsageHistory {
  id        Int              @id @default(autoincrement())
  stationId Int
  station   HydrationStation @relation(fields: [stationId], references: [id])
  createdAt DateTime         @default(now())
  day       DateTime? // To record once a day

  measuredAt DateTime // Obtained from the timestamp of the request sent to the server (x-axis)
  waterFlOz  Float // Calculated from sensor readings (y-axis)

  @@unique([stationId, day]) // To record once a day
  @@index([measuredAt, waterFlOz])
}

model SensorReadings {
  id        Int              @id @default(autoincrement())
  stationId Int
  station   HydrationStation @relation(fields: [stationId], references: [id])
  createdAt DateTime         @default(now())

  measuredAt         DateTime // Obtained from the timestamp of the request sent to the server
  noOfCleaningCycles Int
  doneCleaning       Boolean
  soapWeight         Float
}
