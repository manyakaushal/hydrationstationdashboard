generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  station HydrationStation[]
}

model HydrationStation {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  bottlesWashed       Int
  lastCleaningCycleAt DateTime?
  powerUsageHistory   PowerUsageHistory[]
  waterUsageHistory   WaterUsageHistory[]
}

model PowerUsageHistory {
  id        Int              @id @default(autoincrement())
  stationId Int
  station   HydrationStation @relation(fields: [stationId], references: [id])
  createdAt DateTime         @default(now())

  measuredAt DateTime
  powerKw    Float

  @@index([measuredAt, powerKw])
}

model WaterUsageHistory {
  id        Int              @id @default(autoincrement())
  stationId Int
  station   HydrationStation @relation(fields: [stationId], references: [id])
  createdAt DateTime         @default(now())

  measuredAt DateTime
  waterFlOz  Float

  @@index([measuredAt, waterFlOz])
}
